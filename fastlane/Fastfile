require "json"

# Loads the App Store Connect API key from ~/.appstoreconnect/config.json so no
# credentials (key id / issuer id / .p8) are ever committed to this repo.
def asc_api_key
  config = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
  app_store_connect_api_key(
    key_id: config["key_id"],
    issuer_id: config["issuer_id"],
    key_filepath: File.expand_path(config["key_filepath"])
  )
end

default_platform(:ios)

platform :ios do
  # Creating the FIRST app record requires Apple-ID auth (App Store Connect has
  # no API to create apps). Run with a session, e.g.:
  #   fastlane spaceauth -u hi@waiwai.is   # then export the printed FASTLANE_SESSION
  #   FASTLANE_USER=hi@waiwai.is fastlane ios create_app
  desc "Create the App Store Connect app record (one-time, needs Apple-ID session)"
  lane :create_app do
    produce(
      app_identifier: "is.waiwai.goals",
      app_name: "WaiGoals",
      language: "English (U.S.)",
      sku: "is.waiwai.goals",
      team_id: "R4A779QVVY",
      skip_devcenter: true
    )
  end

  desc "Check whether the app record exists in App Store Connect"
  lane :check_app do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find("is.waiwai.goals")
    UI.message(app ? "APP_EXISTS id=#{app.id} name=#{app.name}" : "APP_NOT_FOUND")
  end

  desc "List builds with processing + compliance state"
  lane :builds_status do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find("is.waiwai.goals")
    app.get_builds(includes: "preReleaseVersion").each do |b|
      UI.message("BUILD ver=#{b.version} train=#{b.pre_release_version&.version} " \
                 "processing=#{b.processing_state} encryption=#{b.uses_non_exempt_encryption.inspect}")
    end
  end

  desc "Upload the most recent archive's IPA to TestFlight"
  lane :beta do
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: "is.waiwai.goals",
      ipa: "build/export/WaiGoals.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Upload App Store metadata + screenshots (no binary)"
  lane :upload_all do
    deliver(
      api_key: asc_api_key,
      app_identifier: "is.waiwai.goals",
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end
end

require "fileutils"
require "fastlane_core/provisioning_profile"
require "xcodeproj"

# Only the app Release target uses the distribution profile. Restore the
# generated project even when archive/export fails, so simulator tests stay usable.
def with_release_signing(project_path, app_name, profile_name)
  file = File.join(project_path, "project.pbxproj")
  original = File.binread(file)
  project = Xcodeproj::Project.open(project_path)
  target = project.targets.find { |item| item.name == app_name }
  UI.user_error!("Missing app target #{app_name}") unless target
  configuration = target.build_configurations.find { |item| item.name == "Release" }
  configuration.build_settings.merge!(
    "CODE_SIGN_STYLE" => "Manual",
    "CODE_SIGN_IDENTITY" => "Apple Distribution",
    "DEVELOPMENT_TEAM" => "R4A779QVVY",
    "PROVISIONING_PROFILE_SPECIFIER" => profile_name
  )
  project.save
  yield
ensure
  File.binwrite(file, original) if original
end

platform :ios do
  desc "Archive the current project.yml version; optionally upload to TestFlight"
  lane :release_testflight do |options|
    root = File.expand_path("..", __dir__)
    app_name = "WaiGoals"
    bundle_id = "is.waiwai.goals"
    api_key = asc_api_key
    sh("xcodegen", "generate", "--spec", File.join(root, "project.yml"))
    project_path = File.join(root, "#{app_name}.xcodeproj")
    profiles = File.join(root, "build", "profiles")
    FileUtils.mkdir_p(profiles)
    get_provisioning_profile(
      api_key: api_key, app_identifier: bundle_id,
      cert_owner_name: "WaiWai, LLC", provisioning_name: "#{app_name} AppStore",
      output_path: profiles, filename: "#{app_name}_AppStore.mobileprovision",
      skip_install: true
    )
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    UI.user_error!("No distribution profile downloaded") unless profile_path && File.exist?(profile_path)
    profile = FastlaneCore::ProvisioningProfile.parse(profile_path)
    installed = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(installed)
    FileUtils.cp(profile_path, File.join(installed, "#{profile.fetch('UUID')}.mobileprovision"))
    with_release_signing(project_path, app_name, profile.fetch("Name")) do
      build_app(
        project: project_path, scheme: app_name, configuration: "Release", clean: true,
        derived_data_path: File.expand_path("~/Library/Caches/WaiSuiteBuilds/Goals"),
        export_method: "app-store", xcargs: "COMPILER_INDEX_STORE_ENABLE=NO",
        export_options: { method: "app-store", signingStyle: "manual", teamID: "R4A779QVVY",
          signingCertificate: "Apple Distribution", provisioningProfiles: { bundle_id => profile.fetch("Name") } },
        output_directory: File.join(root, "build", "export"), output_name: "#{app_name}.ipa"
      )
    end
    unless %w[1 true yes].include?(options[:skip_upload].to_s)
      upload_to_testflight(api_key: api_key, app_identifier: bundle_id,
        ipa: File.join(root, "build", "export", "#{app_name}.ipa"),
        skip_waiting_for_build_processing: true, skip_submission: true,
        changelog: options[:changelog])
    end
  end
end
