require "json"

# Loads the App Store Connect API key from ~/.appstoreconnect/config.json so no
# credentials (key id / issuer id / .p8) are ever committed to this repo.
def asc_api_key
  config = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
  app_store_connect_api_key(
    key_id: config["key_id"],
    issuer_id: config["issuer_id"],
    key_filepath: File.expand_path(config["key_filepath"])
  )
end

default_platform(:ios)

platform :ios do
  desc "Create the App Store Connect app record (one-time)"
  lane :create_app do
    asc_api_key # sets the Spaceship token globally; produce picks it up
    produce(
      app_identifier: "is.waiwai.goals",
      app_name: "WaiGoals",
      language: "English (U.S.)",
      sku: "is.waiwai.goals",
      team_id: "R4A779QVVY",
      skip_devcenter: true
    )
  end

  desc "Upload the most recent archive's IPA to TestFlight"
  lane :beta do
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: "is.waiwai.goals",
      ipa: "build/export/WaiGoals.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Upload App Store metadata + screenshots (no binary)"
  lane :upload_all do
    deliver(
      api_key: asc_api_key,
      app_identifier: "is.waiwai.goals",
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end
end
